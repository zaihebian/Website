# ---------------------------------------------------------------------------
# LiqenTech site environment.
# Copy to .env.local for local development (never commit .env.local).
# Without these values the site still runs, but:
#   - behaviour events are not stored (the tracking response says stored:false)
#   - consultation submissions show an honest error instead of a fake success page
#   - /analytics reports that Supabase is not configured
# ---------------------------------------------------------------------------

# --- Mautic (marketing automation: contacts, tags, lead scoring) -----------
MAUTIC_BASE_URL=https://mautic.liqentech.com
MAUTIC_USERNAME=
MAUTIC_PASSWORD=
# Optional: per-request timeout for the Mautic REST API (default 5000 ms)
# MAUTIC_TIMEOUT_MS=5000

# --- Supabase (behaviour events + leads; server-side service role only) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional label shown in /admin (e.g. local, staging, production) so testers know
# which database they are writing to.
# SUPABASE_ENV_LABEL=production

# --- /analytics Basic Auth -------------------------------------------------
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=

# --- Optional --------------------------------------------------------------
# Canonical site URL; set it on preview deployments. Inlined at build time.
# NEXT_PUBLIC_SITE_URL=https://liqentech.com

# Abuse protection for the public tracking endpoint (per client IP).
# BEHAVIOR_RATE_LIMIT=120
# BEHAVIOR_LEAD_RATE_LIMIT=30

# --- Synthetic traffic (scripts/simulate-visitors.mjs) ---------------------
# Remote targets need an explicit opt-in; prefer a local instance.
# SIM_ALLOW_PRODUCTION=1
